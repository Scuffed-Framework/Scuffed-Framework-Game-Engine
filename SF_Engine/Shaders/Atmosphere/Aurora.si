#ifndef AURORA_BOREALIS_SI
#define AURORA_BOREALIS_SI

mat2 aurora_mm2(in float a) { float c=cos(a),s=sin(a); return mat2(c,s,-s,c); }
const mat2 aurora_m2 = mat2(0.95534,0.29552,-0.29552,0.95534);

float aurora_tri(in float x) { return clamp(abs(fract(x)-.5),0.01,0.49); }
vec2  aurora_tri2(in vec2 p)  {
    return vec2(aurora_tri(p.x)+aurora_tri(p.y),
                aurora_tri(p.y+aurora_tri(p.x)));
}

float triNoise2d(in vec2 p, float spd, float time) {
    float z=1.8, z2=2.5, rz=0.;
    p *= aurora_mm2(p.x*0.06);
    vec2 bp = p;
    for (float i=0.; i<4.; i++) {
        vec2 dg = aurora_tri2(bp*1.85)*0.75;
        dg *= aurora_mm2(time*spd);
        p  -= dg/z2;
        bp *= 1.3;
        z2 *= 0.45;
        z  *= 0.42;
        p  *= 1.21+(rz-1.0)*0.02;
        rz += aurora_tri(p.x+aurora_tri(p.y))*z;
        p  *= -aurora_m2;
    }
    return clamp(1./pow(rz*29.,1.3), 0., 0.55);
}

vec4 sampleAurora(vec3 rd, float camHeight, float time) {
    const float AURORA_LOW  =  80.0;   // bottom of curtain
    const float AURORA_HIGH = 300.0;   // top  of curtain

    float eps = 1e-4;
    float ryInv = 1.0 / (abs(rd.y) > eps ? rd.y : sign(rd.y)*eps);

    float tLow  = (AURORA_LOW  - camHeight) * ryInv;
    float tHigh = (AURORA_HIGH - camHeight) * ryInv;
    float tMin  = max(min(tLow, tHigh), 0.0);   // clamp behind-camera
    float tHit  = max(tLow, tHigh);
    // If the entire slab is behind the camera, bail out immediately
    if (tHit < 0.0) return vec4(0.0);

    const int   STEPS   = 32;          // was 50  – ~36 % fewer samples
    const float COL_S   = 0.043;
    const float INT     = 1.5;
    const float FALLOFF = 0.065;
    const float NOISE_S = 0.18;        // was 0.06 – faster curtain shimmer

    //   layer A: slow drift
    //   layer B: faster ripple offset  (both driven by time, not time*0.01)
    vec2 windA = vec2(time * 0.04,  time * 0.015);
    vec2 windB = vec2(time * 0.11, -time * 0.03 );

    float ph = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898,78.233)))*43758.5453);

    float tRange  = tHit - tMin;
    float tStep   = tRange / float(STEPS);

    vec4 col    = vec4(0.0);
    vec4 avgCol = vec4(0.0);

    for (int i = 0; i < STEPS; i++) {
        float fi = float(i);

        // Sample t within slab (jittered first step avoids banding)
        float t = tMin + (fi + ph * 0.5) * tStep;

        // World-space sample position (only XZ matter for the noise lookup)
        // camHeight not needed here because the noise is purely directional
        vec3  bpos = t * rd;
        vec2  p    = bpos.xz;         // use X and Z, not Z and X (minor clarity)

        // Two-layer animated lookup
        float rzt = triNoise2d(p*0.002 + windA, NOISE_S, time)
                  + triNoise2d(p*0.003 + windB, NOISE_S * 0.6, time) * 0.4;
        rzt = clamp(rzt, 0.0, 0.55);

        // Colour – same hue formula as original
        vec4 col2;
        col2.a   = rzt;
        col2.rgb = (sin(1.0 - vec3(2.15,-1.0,1.0) + fi*COL_S)*0.5+0.5)*rzt;

        avgCol = mix(avgCol, col2, 0.5);

        // Exponential decay + smooth ramp-in  (fi replaced pow with multiply)
        col += avgCol * exp2(-fi * FALLOFF - 2.5)
                      * smoothstep(0.0, 5.0, fi);
    }

    // Fade out when looking nearly horizontal (grazing angle)
    col *= clamp(rd.y * 15.0 + 0.4, 0.0, 1.0);
    col *= INT;
    return col;
}

#endif