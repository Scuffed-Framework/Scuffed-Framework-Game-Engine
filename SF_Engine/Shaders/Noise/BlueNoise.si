#ifndef BlueNoise_SI
#define BlueNoise_SI

// ---------------------------------------------------------------------------
// Procedural blue-noise approximation (no LUTs, no texture fetches).
//
// This is NOT a faithful reimplementation of Heitz et al. 2019 — that paper's
// quality comes from genuine multi-dimensional Sobol' points (which need
// per-dimension direction numbers) plus a *pre-optimized* ranking/scrambling
// tile that was fit offline to minimize low-frequency error. Baking that
// offline optimization into a closed-form hash isn't really possible; you'd
// be trading one kind of table for another.
//
// What this does instead: base-2 Van der Corput as a 1D low-discrepancy
// generator (that's dimension 0 of Sobol'), decorrelated per pixel and per
// dimension using Burley's hash-based Owen scramble (JCGT 2020). Good enough
// for temporal dithering / TAA jitter — which is what OceanClipmap and the
// cloud raymarch use this for — but don't assume it matches the paper's
// stratification guarantees across dimensions. Worth a comment here so a
// future pass doesn't assume drop-in equivalence.
// ---------------------------------------------------------------------------

// 32-bit -> 32-bit integer hash (Murmur3 finalizer)
uint hashMurmur3(uint x)
{
    x ^= x >> 16u;
    x *= 0x85ebca6bu;
    x ^= x >> 13u;
    x *= 0xc2b2ae35u;
    x ^= x >> 16u;
    return x;
}

// Sobol' base-2 Van der Corput radical inverse
uint sobolVdC(uint bits)
{
    bits = ( bits << 16u) | ( bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return bits;
}

// Burley 2020 "Practical Hash-based Owen Scrambling" nested-uniform hash.
// Operates MSB-first (hence the bit reversals on the way in/out), which is
// what makes it approximate real Owen scrambling instead of just being a
// generic bit-lerper.
uint owenScramble(uint x, uint seed)
{
    x = reversebits(x);
    x ^= x * 0x3d20adeau;
    x += seed;
    x *= (seed >> 16u) | 1u;
    x ^= x * 0x05526c56u;
    x ^= x * 0x53a22864u;
    return reversebits(x);
}

float BlueNoiseErrorDistrib(uint pixel_i, uint pixel_j, uint sampleIndex, uint sampleDimension)
{
    // Fold pixel coords + dimension into one per-stream seed. Multiplying
    // sampleDimension by a large odd constant keeps different dimensions
    // from aliasing onto the same seed for small pixel coords.
    uint seed = hashMurmur3(pixel_i * 1973u + pixel_j * 9277u + sampleDimension * 26699u + 1u);

    // 1D low-discrepancy base value for this sample index.
    uint vdc = sobolVdC(sampleIndex);

    // Owen-scramble it against the per-pixel/per-dimension seed.
    uint scrambled = owenScramble(vdc, seed);

    // Full 32-bit uint -> [0,1). Using all 32 bits (not just a top byte)
    // avoids banding compared to the original 256-entry LUT's 8-bit range.
    return (0.5 + float(scrambled >> 8u)) * (1.0 / 16777216.0); // top 24 bits, safe in fp32
}

#endif // BlueNoise_SI