#ifndef SHARED_BLUENOISE_GLSL
#define SHARED_BLUENOISE_GLSL

float samplerBlueNoiseErrorDistribution_128x128(int x, int y, int frame, uint noiseId)
{
    const uint kPrimeX = 0x9e3779b1;
    const uint kPrimeY = 0x85ebca77;
    uint hash = uint(x) * kPrimeX ^ uint(y) * kPrimeY ^ uint(frame);
    hash = hash ^ (hash >> 16);
    return float(hash) / 4294967296.0;
}

float bayer64(vec2 coord)
{
    int x = int(coord.x) & 7;
    int y = int(coord.y) & 7;
    const int bayer[64] = int[](
        0, 32, 8, 40, 2, 34, 10, 42,
        48, 16, 56, 24, 50, 18, 58, 26,
        12, 44, 4, 36, 14, 46, 6, 38,
        60, 28, 52, 20, 62, 30, 54, 22,
        3, 35, 11, 43, 1, 33, 9, 41,
        51, 19, 59, 27, 49, 17, 57, 25,
        15, 47, 7, 39, 13, 45, 5, 37,
        63, 31, 55, 23, 61, 29, 53, 21
    );
    return float(bayer[y * 8 + x]) / 64.0;
}

#endif