#ifndef SHARED_ATMOSPHERE_GLSL
#define SHARED_ATMOSPHERE_GLSL

struct AtmosphereParameters
{
    float bottomRadius;
    float topRadius;
    float rayleighDensityExpScale;
    float mieDensityExpScale;
    float rayleighScattering;
    float mieScattering;
    float miePhaseG;
    float absorptionExtinction;
    
    float cloudAreaStartHeight;
    float cloudAreaThickness;
    float cloudMultiScatterExtinction;
    float cloudGodRayScale;
};

struct SkyInfo
{
    vec3 direction;
    vec3 color;
    float intensity;
    
    struct CascadeConfig
    {
        uint cascadeCount;
        uint percascadeDimXY;
        float cascadeBorderAdopt;
    } cacsadeConfig;
    
    struct AtmosphereConfig
    {
        float cloudCoverage;
        float cloudDensity;
        float cloudSpeed;
        vec3 cloudDirection;
        float cloudWeatherUVScale;
        float cloudBasicNoiseScale;
        float cloudDetailNoiseScale;
        float cloudLightBasicStep;
        float cloudLightStepMul;
        uint cloudLightStepNum;
        uint cloudMarchingStepNum;
        float cloudMaxTraceingDistance;
        float cloudTracingStartMaxDistance;
        float cloudPhaseForward;
        float cloudPhaseBackward;
        float cloudPhaseMixFactor;
        float cloudPowderPow;
        float cloudPowderScale;
        float cloudShadingSunLightScale;
        float cloudNoiseScale;
        float cloudFogFade;
        int cloudEnableGroundContribution;
        int cloudGodRay;
        vec3 cloudAlbedo;
    } atmosphereConfig;
};

AtmosphereParameters getAtmosphereParameters(PerFrameData frameData)
{
    AtmosphereParameters atmos;
    atmos.bottomRadius = 6371000.0 * 0.001;
    atmos.topRadius = atmos.bottomRadius + 100000.0 * 0.001;
    atmos.rayleighDensityExpScale = 8000.0;
    atmos.mieDensityExpScale = 1200.0;
    atmos.rayleighScattering = 0.0058;
    atmos.mieScattering = 0.0036;
    atmos.miePhaseG = 0.98;
    atmos.absorptionExtinction = 0.0005;
    atmos.cloudAreaStartHeight = (atmos.bottomRadius + frameData.sky.atmosphereConfig.cloudAreaStartOffset) * 0.001;
    atmos.cloudAreaThickness = frameData.sky.atmosphereConfig.cloudAreaThickness * 0.001;
    atmos.cloudMultiScatterExtinction = frameData.sky.atmosphereConfig.cloudMultiScatterExtinction;
    atmos.cloudGodRayScale = frameData.sky.atmosphereConfig.cloudGodRayScale;
    return atmos;
}

void lutTransmittanceParamsToUv(AtmosphereParameters atmosphere, float height, float viewZenithCosAngle, out vec2 uv)
{
    float x = (height - atmosphere.bottomRadius) / (atmosphere.topRadius - atmosphere.bottomRadius);
    float y = (viewZenithCosAngle + 1.0) * 0.5;
    uv = vec2(x, y);
}

void skyViewLutParamsToUv(AtmosphereParameters atmosphere, bool bGround, float viewZenithCosAngle, float lightViewCosAngle, float height, vec2 lutSize, out vec2 uv)
{
    float x = (acos(lightViewCosAngle) / 3.14159265359);
    float y = (acos(viewZenithCosAngle) / 3.14159265359);
    uv = vec2(x, y);
}

#endif