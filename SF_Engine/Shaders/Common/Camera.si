#ifndef CAMERA_S
#define CAMERA_S

struct Camera
{
    // 16 bytes
    float aspectRatio;
    float deltaTime;
    int screenWidth;
    int screenHeight;

    // 16 bytes
    float4 cameraPosition;

    // 64 bytes each
    float4x4 inverseProjection;
    float4x4 inverseView;
    float4x4 projection;
    float4x4 view;
    float4x4 viewProjection;
    float4x4 prevViewProjection;
};

#endif