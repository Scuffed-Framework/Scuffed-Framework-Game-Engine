float3 SampleSH9(float3 n, float3 sh[9])
{
    float x = n.x, y = n.y, z = n.z;

    return max(
        // L0
        sh[0] * 0.886227

        // L1
        + sh[1] * (1.023328 * y)
        + sh[2] * (1.023328 * z)
        + sh[3] * (1.023328 * x)

        // L2
        + sh[4] * (0.858086 * x * y)
        + sh[5] * (0.858086 * y * z)
        + sh[6] * (0.743125 * z * z - 0.247708)
        + sh[7] * (0.858086 * x * z)
        + sh[8] * (0.429043 * (x*x - y*y)),

        float3(0.0)
    );
}

float3 SHEvalLinearL0L1(
    float3 n,
    float4 shAr,
    float4 shAg,
    float4 shAb)
{
    float4 vA = float4(n, 1.0);

    return float3(
        dot(shAr, vA),
        dot(shAg, vA),
        dot(shAb, vA)
    );
}

float3 SHEvalLinearL2(
    float3 n,
    float4 shBr,
    float4 shBg,
    float4 shBb,
    float4 shC)
{
    float4 vB = n.xyzz * n.yzzx;

    float3 res = float3(
        dot(shBr, vB),
        dot(shBg, vB),
        dot(shBb, vB)
    );

    float vC = n.x * n.x - n.y * n.y;

    res += shC.rgb * vC;

    return res;
}

float3 EvaluateSH(
    float3 normalWS,
    float4 shAr, float4 shAg, float4 shAb,
    float4 shBr, float4 shBg, float4 shBb,
    float4 shC)
{
    float3 res = SHEvalLinearL0L1(
        normalWS,
        shAr, shAg, shAb);

    res += SHEvalLinearL2(
        normalWS,
        shBr, shBg, shBb,
        shC);

    return res;
}

float3 SHEvalLinearL0L1(
    float3 n,
    float4 shAr,
    float4 shAg,
    float4 shAb)
{
    float4 vA = float4(n, float(1.0));

    return float3(
        dot(shAr, vA),
        dot(shAg, vA),
        dot(shAb, vA)
    );
}

float3 f16_SHEvalLinearL2(
    float3 n,
    float4 shBr,
    float4 shBg,
    float4 shBb,
    float4 shC)
{
    float4 vB = n.xyzz * n.yzzx;

    float3 res = float3(
        dot(shBr, vB),
        dot(shBg, vB),
        dot(shBb, vB)
    );

    float vC = n.x * n.x - n.y * n.y;

    res += shC.rgb * vC;

    return res;
}

float3 f16_EvaluateSH(
    float3 normalWS,
    float4 shAr, float4 shAg, float4 shAb,
    float4 shBr, float4 shBg, float4 shBb,
    float4 shC)
{
    float3 res =
        SHEvalLinearL0L1(normalWS, shAr, shAg, shAb) +
        SHEvalLinearL2(normalWS, shBr, shBg, shBb, shC);

    return max(res, float3(float(0.0)));
}