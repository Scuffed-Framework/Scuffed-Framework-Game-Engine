

vec3 SampleSH9(vec3 n, vec3 sh[9])
{
    float x = n.x, y = n.y, z = n.z;

    return max(
        // L0
        sh[0] * 0.886227

        // L1
        + sh[1] * (1.023328 * y)
        + sh[2] * (1.023328 * z)
        + sh[3] * (1.023328 * x)

        // L2
        + sh[4] * (0.858086 * x * y)
        + sh[5] * (0.858086 * y * z)
        + sh[6] * (0.743125 * z * z - 0.247708)
        + sh[7] * (0.858086 * x * z)
        + sh[8] * (0.429043 * (x*x - y*y)),

        vec3(0.0)
    );
}

vec3 SHEvalLinearL0L1(
    vec3 n,
    vec4 shAr,
    vec4 shAg,
    vec4 shAb)
{
    vec4 vA = vec4(n, 1.0);

    return vec3(
        dot(shAr, vA),
        dot(shAg, vA),
        dot(shAb, vA)
    );
}

vec3 SHEvalLinearL2(
    vec3 n,
    vec4 shBr,
    vec4 shBg,
    vec4 shBb,
    vec4 shC)
{
    vec4 vB = n.xyzz * n.yzzx;

    vec3 res = vec3(
        dot(shBr, vB),
        dot(shBg, vB),
        dot(shBb, vB)
    );

    float vC = n.x * n.x - n.y * n.y;

    res += shC.rgb * vC;

    return res;
}

vec3 EvaluateSH(
    vec3 normalWS,
    vec4 shAr, vec4 shAg, vec4 shAb,
    vec4 shBr, vec4 shBg, vec4 shBb,
    vec4 shC)
{
    vec3 res = SHEvalLinearL0L1(
        normalWS,
        shAr, shAg, shAb);

    res += SHEvalLinearL2(
        normalWS,
        shBr, shBg, shBb,
        shC);

    return res;
}

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

f16vec3 f16_SHEvalLinearL0L1(
    f16vec3 n,
    f16vec4 shAr,
    f16vec4 shAg,
    f16vec4 shAb)
{
    f16vec4 vA = f16vec4(n, float16_t(1.0));

    return f16vec3(
        dot(shAr, vA),
        dot(shAg, vA),
        dot(shAb, vA)
    );
}

f16vec3 f16_SHEvalLinearL2(
    f16vec3 n,
    f16vec4 shBr,
    f16vec4 shBg,
    f16vec4 shBb,
    f16vec4 shC)
{
    f16vec4 vB = n.xyzz * n.yzzx;

    f16vec3 res = f16vec3(
        dot(shBr, vB),
        dot(shBg, vB),
        dot(shBb, vB)
    );

    float16_t vC = n.x * n.x - n.y * n.y;

    res += shC.rgb * vC;

    return res;
}

f16vec3 f16_EvaluateSH(
    f16vec3 normalWS,
    f16vec4 shAr, f16vec4 shAg, f16vec4 shAb,
    f16vec4 shBr, f16vec4 shBg, f16vec4 shBb,
    f16vec4 shC)
{
    f16vec3 res =
        SHEvalLinearL0L1(normalWS, shAr, shAg, shAb) +
        SHEvalLinearL2(normalWS, shBr, shBg, shBb, shC);

    return max(res, f16vec3(float16_t(0.0)));
}