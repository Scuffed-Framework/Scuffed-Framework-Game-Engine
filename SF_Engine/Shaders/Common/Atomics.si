#ifndef ATOMIC_UTILS_SLANG
#define ATOMIC_UTILS_SLANG

// Interlocked operations in Slang use out parameters for the original value
// The atomic variable must be a RWByteAddressBuffer or RWStructuredBuffer element
// For regular variables, Slang doesn't support direct atomics on local variables

int atomicAddInt(inout int mem, int val) 
{
    int original;
    InterlockedAdd(mem, val, original);
    return original;
}

uint atomicAddUint(inout uint mem, uint val) 
{
    uint original;
    InterlockedAdd(mem, val, original);
    return original;
}

int atomicMinInt(inout int mem, int val) 
{
    int original;
    InterlockedMin(mem, val, original);
    return original;
}

int atomicMaxInt(inout int mem, int val) 
{
    int original;
    InterlockedMax(mem, val, original);
    return original;
}

uint atomicMinUint(inout uint mem, uint val) 
{
    uint original;
    InterlockedMin(mem, val, original);
    return original;
}

uint atomicMaxUint(inout uint mem, uint val) 
{
    uint original;
    InterlockedMax(mem, val, original);
    return original;
}

int atomicExchInt(inout int mem, int val) 
{
    int original;
    InterlockedExchange(mem, val, original);
    return original;
}

uint atomicExchUint(inout uint mem, uint val) 
{
    uint original;
    InterlockedExchange(mem, val, original);
    return original;
}

int atomicCmpExchInt(inout int mem, int cmp, int val) 
{
    int original;
    InterlockedCompareExchange(mem, cmp, val, original);
    return original;
}

uint atomicCmpExchUint(inout uint mem, uint cmp, uint val) 
{
    uint original;
    InterlockedCompareExchange(mem, cmp, val, original);
    return original;
}

int atomicAndInt(inout int mem, int val) 
{
    int original;
    InterlockedAnd(mem, val, original);
    return original;
}

uint atomicAndUint(inout uint mem, uint val) 
{
    uint original;
    InterlockedAnd(mem, val, original);
    return original;
}

int atomicOrInt(inout int mem, int val) 
{
    int original;
    InterlockedOr(mem, val, original);
    return original;
}

uint atomicOrUint(inout uint mem, uint val) 
{
    uint original;
    InterlockedOr(mem, val, original);
    return original;
}

int atomicXorInt(inout int mem, int val) 
{
    int original;
    InterlockedXor(mem, val, original);
    return original;
}

uint atomicXorUint(inout uint mem, uint val) 
{
    uint original;
    InterlockedXor(mem, val, original);
    return original;
}

// For float atomics, we need to use the uint version with bit casting
// Note: In Slang, you cannot directly take the address of a float for atomic operations
// This function is provided as a wrapper, but you'll need to use it with RWByteAddressBuffer
float atomicAddFloat(inout float mem, float val) 
{
    // Slang doesn't support direct float atomics on local variables
    // This would need to be used with RWByteAddressBuffer or similar
    uint originalBits;
    uint currentBits = asuint(mem);
    
    while (true) 
    {
        float currentVal = asfloat(currentBits);
        float newVal = currentVal + val;
        uint newBits = asuint(newVal);
        
        uint prevBits;
        InterlockedCompareExchange(mem, currentBits, newBits, prevBits);
        
        if (prevBits == currentBits) 
            return asfloat(prevBits);
        
        currentBits = prevBits;
    }
}

// Generic CAS loop utility (int version)
// In Slang, you cannot pass function pointers or lambdas directly
// Use this with a macro or inline the operation
int atomicCASLoop(inout int mem, int oldVal, int op(int oldVal)) 
{
    int current = oldVal;
    while (true) 
    {
        int newVal = op(current);
        int prev;
        InterlockedCompareExchange(mem, current, newVal, prev);
        if (prev == current) 
            return current;
        current = prev;
    }
}

// Alternative: Use a macro-based approach for the CAS loop
// Since Slang doesn't support function pointers well, use a macro
#define ATOMIC_CAS_LOOP(mem, op) \
    do { \
        int oldVal = (mem); \
        while (true) { \
            int newVal = op(oldVal); \
            int prev; \
            InterlockedCompareExchange((mem), oldVal, newVal, prev); \
            if (prev == oldVal) break; \
            oldVal = prev; \
        } \
    } while(0)

#endif // ATOMIC_UTILS_SLANG