#ifndef VERTOUT_COMMON
#define VERTOUT_COMMON

#define Input(x,y) [[vk::binding(x, y)]]

struct VSInput
{
    float4 position     : SV_Position;
    uint vertexID       : SV_VertexID

    // Clip/world/object
    float4 clipPos      : TEXCOORD0;
    float3 worldPos     : TEXCOORD1;
    float3 objectPos    : TEXCOORD2;
    float3 viewPos      : TEXCOORD3;

    // Basis
    float3x3 tbn        : TEXCOORD4;

    // UVs
    float2 uv0          : TEXCOORD5;
    float2 uv1          : TEXCOORD6;

    // Misc
    float4 color        : COLOR0;
    float4 screenPos    : TEXCOORD7;
    float4 fragCoord    : TEXCOORD8;

    // Camera
    float3 viewDir      : TEXCOORD9;
    float  linearDepth  : TEXCOORD10;
};


struct VSOutput
{
    // Required
    float4 position     : SV_Position;
    uint vertexID       : SV_VertexID

    // Clip/world/object
    float4 clipPos      : TEXCOORD0;
    float3 worldPos     : TEXCOORD1;
    float3 objectPos    : TEXCOORD2;
    float3 viewPos      : TEXCOORD3;

    // Basis
    float3 worldNormal  : TEXCOORD4;
    float3 worldTangent : TEXCOORD5;
    float3 worldBitangent : TEXCOORD6;
    float3x3 tbn        : TEXCOORD7;

    // UVs
    float2 uv0          : TEXCOORD10;
    float2 uv1          : TEXCOORD11;

    // Misc
    float4 color        : COLOR0;
    float4 screenPos    : TEXCOORD12;
    float4 fragCoord    : TEXCOORD13;

    // Camera
    float3 viewDir      : TEXCOORD14;
    float  linearDepth  : TEXCOORD15;
};

struct FSOutput
{
    float4 color : SV_Target;
};


VSOutput RunVertexShader(VSInput in)
{
    VSOutput out;

    out.clipPos        = in.clipPos;
    out.worldPos       = in.worldPos;
    out.objectPos      = in.objectPos;
    out.viewPos        = in.viewPos;
    out.worldNormal    = in.tbn[2];
    out.worldTangent   = in.tbn[0];
    out.worldBitangent = in.tbn[1];
    out.tbn            = in.tbn;
    out.uv0            = in.uv0;
    out.uv1            = in.uv1;
    out.color          = in.color;
    out.screenPos      = in.screenPos;
    out.fragCoord      = in.fragCoord;
    out.viewDir        = in.viewDir;
    out.linearDepth    = in.linearDepth;
    
    return out;
}

// idk
VSOutput BuildVSOutput(
    float3 objectPos,
    float3 worldPos,
    float3 viewPos,
    float4 clipPos,
    float3x3 tbn, // already orthonormalized world-space TBN
    float2 uv0, float2 uv1,
    float4 color,
    float3 cameraWorldPos)
{
    VSOutput o;
    o.position = clipPos;
    o.clipPos = clipPos;
    o.worldPos = worldPos;
    o.objectPos = objectPos;
    o.viewPos = viewPos;

    o.worldNormal = tbn[2]; // convention: TBN columns are (T, B, N)
    o.worldTangent = tbn[0];
    o.worldBitangent = tbn[1];
    o.tbn = tbn;

    o.uv0 = uv0;
    o.uv1 = uv1;
    o.color = color;

    o.screenPos = clipPos; // divide by w in pixel shader, or precompute here if preferred
    o.fragCoord = clipPos;
    o.viewDir = normalize(cameraWorldPos - worldPos);
    o.linearDepth = viewPos.z; // sign/convention depends on your view-space handedness

    return o;
}

#endif