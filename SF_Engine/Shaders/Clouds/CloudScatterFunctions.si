#ifndef CloudScatterFunctionsInclude
#define CloudScatterFunctionsInclude

float rayleighPhase(float cosTheta)
{
    return (3.0 / (16.0 * 3.14159265359)) * (1.0 + cosTheta * cosTheta);
}

float DualLobPhase(float g1, float g2, float lerp, float cosTheta)
{
    return lerp * HenyeyGreensteinPhaseFunction(g1, cosTheta) + (1.0 - lerp) * HenyeyGreensteinPhaseFunction(g2, cosTheta);
}

float BeerAbsorption(float density)
{
    return exp(-density);
}
float BeerAbsorptionMultipleScattering(float density)
{
    return 1.0 / (1.0 + 0.35 * density + 0.065 * density * density);
}
float HenyeyGreensteinPhaseFunction(float eccentricity, float viewDirDotLight)
{
    return (1.0 - eccentricity * eccentricity) / (4.0 * 3.14159265358979 * pow(1.0 + eccentricity * eccentricity
                                                 - 2.0 * eccentricity * viewDirDotLight, 3.0/2.0));
}
void GetPhaseFunctions(float dotLight, out float directLightingPhaseFunction, out float indirectLightingPhaseFunction)
{
    directLightingPhaseFunction = 0.2 * HenyeyGreensteinPhaseFunction(0.8, dotLight);

    indirectLightingPhaseFunction = 2.5 * HenyeyGreensteinPhaseFunction(0.2, dotLight) +
                                    0.7 * HenyeyGreensteinPhaseFunction(-0.4, dotLight);
}

float GetHeightFraction(float3 position, float3 planetPosition, float innerCloudRadius, float outerCloudRadius)
{
    float altitude = length(position - planetPosition);
    return (altitude - innerCloudRadius) / (outerCloudRadius - innerCloudRadius);
}

float Powder(float opticalDepth)
{
	return pow(opticalDepth * 20.0, 0.5) /* times scale?*/;
}

#endif