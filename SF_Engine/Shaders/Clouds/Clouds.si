#include "Color/ColorCommon.si"
#include "Clouds/CloudScatterFunctions.si"
#include "Atmosphere/Atmosphere.si"

#define MsCount 2

const static int MAX_STEPS = 32;
const static int LIGHT_STEPS = 8;

struct CloudUBO
{
    float cloudBottomRadius;
    float cloudTopRadius;
    float stepCount;
    float lightStepCount;

    float cloudDensityScale;
    float cloudCoverage;

    float time;

    float sdfRangeMetres;
    int frameIndex;

    float cloudDetailScale;
    float cloudBaseNoiseScale;
    float cloudCurlNoiseScale;

    float cloudWeatherUVScale;
    float percipitationBias;
    float FadeDistance2d;
    float fadeSmoothDist;
};

// Reserved binding for any shader that includes this header: binding 1, set 0.
// Every including file must leave binding 1 free for this.
[[vk::binding(1, 0)]]
ConstantBuffer<CloudUBO> cloud;

[[vk::binding(3, 0)]]
Texture3D<float4> alligatorNoise;

[[vk::binding(6, 0)]]
Texture3D<float> baseNoise;

[[vk::binding(7, 0)]]
Texture3D<float> detailNoise;


[[vk::binding(12, 0)]]
SamplerState linearRepeatSampler;

struct ParticipatingMedia
{
    float extinctionCoefficients[MsCount];
    float transmittanceToLight[MsCount];
    float extinctionAcc[MsCount];
};

float remap(float value, float originalMin, float originalMax, float newMin, float newMax)
{
    return newMin + (saturate((value - originalMin) / (originalMax - originalMin)) * (newMax - newMin));
}

float cloudMap(float3 posMeter, float normalizeHeight, float time)
{
    const float kCoverage = cloud.cloudCoverage;
    const float kDensity = cloud.cloudDensityScale;

    const float3 windDirection = normalize(float3(0.5, 0.0, 0.5));
    const float cloudSpeed = 5.0f;

    posMeter += windDirection * normalizeHeight * 500.0f;
    float3 posKm = posMeter * 0.001;

    float3 windOffset = (windDirection + float3(0.0, 0.1, 0.0)) * time * cloudSpeed;

    float3 sampleUv = float3(
        posKm.x * cloud.cloudWeatherUVScale,
        0.5, // fixed Z slice in the 3D texture
        posKm.z * cloud.cloudWeatherUVScale
    );

    float weatherValue = alligatorNoise.SampleLevel(
        linearRepeatSampler,
        sampleUv,
        0.0
    ).b;

    // Fix: Use .xy for the UV coordinates
    float3 curlUv = float3(
        posMeter.x,
        posMeter.y,
        posMeter.z
    ) * 0.000001;

    curlUv.xz += time * cloudSpeed * 50.0 * 0.000001;
    curlUv += 0.5;

    float localCoverage = alligatorNoise.SampleLevel(
        linearRepeatSampler,
        curlUv,
        0.0
    ).r;

    localCoverage = saturate(localCoverage * 3.0 - 0.75) * 0.2;

    float coverage = saturate(kCoverage * (localCoverage + weatherValue.x));
    float gradienShape = remap(normalizeHeight, 0.00, 0.10, 0.1, 1.0) * remap(normalizeHeight, 0.10, 0.80, 1.0, 0.2);

    float3 baseUv = (posKm + windOffset) * cloud.cloudDetailScale;
    float basicNoise = baseNoise.SampleLevel(linearRepeatSampler, baseUv, 0.0).r;
    float basicCloudNoise = gradienShape * basicNoise;

    float basicCloudWithCoverage = coverage * remap(basicCloudNoise, 1.0 - coverage, 1, 0, 1);

    float3 sampleDetailNoise = posKm - windOffset * 0.15;
    float3 detailUv = sampleDetailNoise * cloud.cloudDetailScale;
    float detailNoiseComposite = detailNoise.SampleLevel(linearRepeatSampler, detailUv, 0.0).r;
    float detailNoiselerpByHeight = 0.2 * lerp(detailNoiseComposite, 1 - detailNoiseComposite, saturate(normalizeHeight * 10.0));

    float densityShape = saturate(0.01 + normalizeHeight * 1.15) * kDensity *
        remap(normalizeHeight, 0.0, 0.1, 0.0, 1.0) *
        remap(normalizeHeight, 0.8, 1.0, 1.0, 0.0);

    float cloudDensity = remap(basicCloudWithCoverage, detailNoiselerpByHeight, 1.0, 0.0, 1.0);
    return cloudDensity * densityShape;
}

struct ParticipatingMediaPhase
{
    float phase[MsCount];
};

ParticipatingMediaPhase getParticipatingMediaPhase(float basePhase, float baseMsPhaseFactor)
{
    ParticipatingMediaPhase participatingMediaPhase;
    participatingMediaPhase.phase[0] = basePhase;

    const float uniformPhase = 1.0 / (4.0 * 3.14159265358979323846); // 1/(4*PI)
    float MsPhaseFactor = baseMsPhaseFactor;

    for (int ms = 1; ms < MsCount; ms++)
    {
        participatingMediaPhase.phase[ms] = lerp(uniformPhase, participatingMediaPhase.phase[0], MsPhaseFactor);
        MsPhaseFactor *= MsPhaseFactor;
    }

    return participatingMediaPhase;
}