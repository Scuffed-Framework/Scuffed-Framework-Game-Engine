// CloudNoise.si
// Tileable noise primitives for volumetric cloud shape and detail.
// Adapted from "Real-time PBR Volumetric Clouds" (robobo1221) and
// Andrew Schneider "Real-Time Volumetric Cloudscapes" (GPU Pro 7).
//
// Include with:  #import "Clouds/CloudNoise"

#ifndef CLOUD_NOISE_SI
#define CLOUD_NOISE_SI

// ---------------------------------------------------------------------------
// Hash by David Hoskins
// ---------------------------------------------------------------------------
#define UI0 1597334673U
#define UI1 3812015801U
#define UI2 uvec2(UI0, UI1)
#define UI3 uvec3(UI0, UI1, 2798796415U)
#define UIF (1.0 / float(0xffffffffU))

vec3 hash33(vec3 p)
{
    uvec3 q = uvec3(ivec3(p)) * UI3;
    q = (q.x ^ q.y ^ q.z) * UI3;
    return -1.0 + 2.0 * vec3(q) * UIF;
}

// ---------------------------------------------------------------------------
// Utility
// ---------------------------------------------------------------------------
float remap(float x, float a, float b, float c, float d)
{
    return (((x - a) / (b - a)) * (d - c)) + c;
}

// ---------------------------------------------------------------------------
// Tileable gradient (Perlin) noise  -- quintic interpolant, iq-style
// ---------------------------------------------------------------------------
float gradientNoise(vec3 x, float freq)
{
    vec3 p = floor(x);
    vec3 w = fract(x);

    // Quintic interpolant
    vec3 u = w * w * w * (w * (w * 6.0 - 15.0) + 10.0);

    // Gradients at the 8 corners
    vec3 ga = hash33(mod(p + vec3(0.0, 0.0, 0.0), freq));
    vec3 gb = hash33(mod(p + vec3(1.0, 0.0, 0.0), freq));
    vec3 gc = hash33(mod(p + vec3(0.0, 1.0, 0.0), freq));
    vec3 gd = hash33(mod(p + vec3(1.0, 1.0, 0.0), freq));
    vec3 ge = hash33(mod(p + vec3(0.0, 0.0, 1.0), freq));
    vec3 gf = hash33(mod(p + vec3(1.0, 0.0, 1.0), freq));
    vec3 gg = hash33(mod(p + vec3(0.0, 1.0, 1.0), freq));
    vec3 gh = hash33(mod(p + vec3(1.0, 1.0, 1.0), freq));

    // Dot products
    float va = dot(ga, w - vec3(0.0, 0.0, 0.0));
    float vb = dot(gb, w - vec3(1.0, 0.0, 0.0));
    float vc = dot(gc, w - vec3(0.0, 1.0, 0.0));
    float vd = dot(gd, w - vec3(1.0, 1.0, 0.0));
    float ve = dot(ge, w - vec3(0.0, 0.0, 1.0));
    float vf = dot(gf, w - vec3(1.0, 0.0, 1.0));
    float vg = dot(gg, w - vec3(0.0, 1.0, 1.0));
    float vh = dot(gh, w - vec3(1.0, 1.0, 1.0));

    return va
        + u.x * (vb - va)
        + u.y * (vc - va)
        + u.z * (ve - va)
        + u.x * u.y * (va - vb - vc + vd)
        + u.y * u.z * (va - vc - ve + vg)
        + u.z * u.x * (va - vb - ve + vf)
        + u.x * u.y * u.z * (-va + vb + vc - vd + ve - vf - vg + vh);
}

// ---------------------------------------------------------------------------
// Tileable Worley noise  (inverted: 1 = inside cell, 0 = edge)
// ---------------------------------------------------------------------------
float worleyNoise(vec3 uv, float freq)
{
    vec3 id = floor(uv);
    vec3 p  = fract(uv);

    float minDist = 1e5;
    for (float x = -1.0; x <= 1.0; x += 1.0)
    {
        for (float y = -1.0; y <= 1.0; y += 1.0)
        {
            for (float z = -1.0; z <= 1.0; z += 1.0)
            {
                vec3 offset = vec3(x, y, z);
                vec3 h      = hash33(mod(id + offset, vec3(freq))) * 0.5 + 0.5;
                h          += offset;
                vec3 d      = p - h;
                minDist     = min(minDist, dot(d, d));
            }
        }
    }
    return 1.0 - minDist;   // inverted: 1 inside cell centre
}

// ---------------------------------------------------------------------------
// Perlin FBM  (tileable, iq decay ~exp2(-0.85) per octave)
// ---------------------------------------------------------------------------
float perlinfbm(vec3 p, float freq, int octaves)
{
    const float G = 0.4493; // exp2(-0.85 * 1)
    float amp   = 1.0;
    float noise = 0.0;
    for (int i = 0; i < octaves; ++i)
    {
        noise += amp * gradientNoise(p * freq, freq);
        freq  *= 2.0;
        amp   *= G;
    }
    return noise;
}

// ---------------------------------------------------------------------------
// Worley FBM  -- Schneider GPU Pro 7 style
// ---------------------------------------------------------------------------
float worleyFbm(vec3 p, float freq)
{
    return worleyNoise(p * freq,        freq       ) * 0.625
         + worleyNoise(p * freq * 2.0,  freq * 2.0 ) * 0.250
         + worleyNoise(p * freq * 4.0,  freq * 4.0 ) * 0.125;
}

// ---------------------------------------------------------------------------
// Cloud base shape
//   Returns a density value in [0,1].
//   p        : world position (metres)
//   cloudBot : bottom of cloud layer (metres)
//   cloudTop : top  of cloud layer  (metres)
//   time     : iTime equivalent
//   speed    : horizontal wind speed
// ---------------------------------------------------------------------------
float getCloudShape(vec3 p, float cloudBot, float cloudTop,
                    float time, float speed)
{
    // Height fraction [0,1] within the cloud slab
    float hFrac = clamp((p.y - cloudBot) / (cloudTop - cloudBot), 0.0, 1.0);

    // Horizontal movement
    vec3 movement = vec3(time * speed, 0.0, time * speed);
    vec3 cloudCoord = p * 0.001 + movement;

    // 4-octave Worley FBM for base shape
    float noise  = worleyFbm(cloudCoord,       4.0) * 0.500;
    noise       += worleyFbm(cloudCoord * 2.0, 8.0) * 0.250;
    noise       += worleyFbm(cloudCoord * 4.0,16.0) * 0.125;
    noise       += worleyFbm(cloudCoord * 8.0,32.0) * 0.062;

    // Height gradient: fade in at base, fade out at top
    const float kBottom = 0.010;
    const float kTop    = 0.004;
    float gradBot = 1.0 - exp2(-kBottom * (p.y - cloudBot));
    float gradTop = 1.0 - exp2(-kTop    * (cloudTop - p.y));  // was missing 1.0 -
    float gradient = gradBot * gradTop;

    float cloud = smoothstep(0.52, 0.60, noise) * gradient;
    return cloud;
}

// ---------------------------------------------------------------------------
// Cloud detail erosion  (high-frequency Perlin added on top of base shape)
// ---------------------------------------------------------------------------
float getCloudDetail(vec3 p, float time, float speed)
{
    vec3 movement  = vec3(time * speed * 1.3, 0.0, time * speed * 1.3);
    vec3 coord     = p * 0.003 + movement;

    float detail   = perlinfbm(coord,       4.0, 3) * 0.500;
    detail        += perlinfbm(coord * 2.0, 8.0, 2) * 0.250;
    detail        += perlinfbm(coord * 4.0,16.0, 1) * 0.125;

    return detail * 0.5 + 0.5;   // remap [-1,1] -> [0,1]
}

#endif // CLOUD_NOISE_SI
