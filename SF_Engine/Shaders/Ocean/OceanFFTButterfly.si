#ifndef OCEAN_FFT_BUTTERFLY_SI
#define OCEAN_FFT_BUTTERFLY_SI

#define FFT_SIZE 1024
#define FFT_LOG_SIZE 10

shared vec4 fftGroupBuffer[2][FFT_SIZE];

void ButterflyValues(uint step, uint index, out uvec2 indices, out vec2 twiddle)
{
    const float twoPi = 6.28318530718;
    uint b = FFT_SIZE >> (step + 1u);
    uint w = b * (index / b);
    uint i = (w + index) % FFT_SIZE;

    float angle = -twoPi / float(FFT_SIZE) * float(w);
    twiddle = vec2(cos(angle), sin(angle));
    // Inverse FFT: conjugate the twiddle factor.
    twiddle.y = -twiddle.y;

    indices = uvec2(i, i + b);
}

vec4 FFT(int threadIndex, vec4 input_)
{
    fftGroupBuffer[0][threadIndex] = input_;
    barrier();
    memoryBarrierShared();

    bool flag = false;

    for (uint step = 0u; step < FFT_LOG_SIZE; ++step)
    {
        uvec2 idx;
        vec2 twiddle;
        ButterflyValues(step, uint(threadIndex), idx, twiddle);

        vec4 v = fftGroupBuffer[flag ? 1 : 0][idx.y];
        vec4 a = fftGroupBuffer[flag ? 1 : 0][idx.x];

        fftGroupBuffer[flag ? 0 : 1][threadIndex] = a + vec4(
            ComplexMult(twiddle, v.xy),
            ComplexMult(twiddle, v.zw));

        flag = !flag;
        barrier();
        memoryBarrierShared();
    }

    return fftGroupBuffer[flag ? 1 : 0][threadIndex];
}

#endif // OCEAN_FFT_BUTTERFLY_SI