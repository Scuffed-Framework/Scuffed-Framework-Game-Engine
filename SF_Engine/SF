#pragma once
#include <vector>
#include <type_traits>
namespace SF::Engine
{
    using namespace std;
    template<typename T>
    using AdvancedArray = vector<T>;

    template<typename T>
    inline constexpr T&& RToL(remove_reference_t<T>& t) noexcept
    {
        return static_cast<T&&>(t);
    }

    template<typename T>
    inline constexpr T&& RToL(remove_reference_t<T>&& t) noexcept
    {
        static_assert(!std::is_lvalue_reference_v<T>,
            "Cannot convert rvalue to lvalue as an lvalue.");

        return static_cast<T&&>(t);
    }
}